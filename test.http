### Base variables
@host = http://localhost:8080
@auth = {{token}}

### -----------------------------
### AUTH CONTROLLER ENDPOINTS
### -----------------------------

### Register a new user
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "ibra",
  "name": "ibra",
  "email": "l@gmail.com",
  "password": "lll"
}

### Verify OTP
POST {{host}}/api/auth/verify-otp
Content-Type: application/json

{
  "email": "l@gmail.com",
  "code": "123456"
}

### Login
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "drstrange@gmail.com",
  "password": "drstrange"
}

### Current user
GET {{host}}/api/auth/me
Authorization: Bearer {{auth}}

### Resend OTP
POST {{host}}/api/auth/resend-otp
Content-Type: application/json

{
  "email": "l@gmail.com"
}

### Complete Onboarding
POST {{host}}/api/auth/onboarding
Authorization: Bearer {{auth}}
Content-Type: application/json

{
  "username": "ibra",
  "name": "Ibrahim",
  "collegeName": "ABC College",
  "rollNumber": "2025-001",
  "image": "https://res.cloudinary.com/demo/image/upload/sample.jpg"
}

### Google Callback (server-side)
POST {{host}}/api/auth/google-callback
Content-Type: application/json

{
  "code": "AUTH_CODE_FROM_GOOGLE",
  "state": "OPTIONAL_STATE_IF_USED"
}

### -----------------------------
### NOTE CONTROLLER ENDPOINTS
### -----------------------------

### Create Note
POST {{host}}/api/notes
Authorization: Bearer {{auth}}
Content-Type: application/json

{
  "title": "Sample Note",
  "pdfLink": "https://drive.google.com/file/d/FILE_ID/view",
  "tags": ["math","algebra"],
  "pdfOption": "link"
}

### Get My Notes
GET {{host}}/api/notes
Authorization: Bearer {{auth}}

### Get Note by ID
GET {{host}}/api/notes/1
Authorization: Bearer {{auth}}

### Delete Note
DELETE {{host}}/api/notes/1
Authorization: Bearer {{auth}}

### Browse Notes (paginated)
GET {{host}}/api/notes/browse?query=&tag=&page=1&limit=10
Authorization: Bearer {{auth}}

### Search Notes (alias)
GET {{host}}/api/notes/search?query=&tag=&page=1&limit=10
Authorization: Bearer {{auth}}

### Get Paginated Notes (alias)
GET {{host}}/api/notes/page?query=&tag=&page=1&limit=10
Authorization: Bearer {{auth}}

### Get Saved Notes
GET {{host}}/api/notes/saved
Authorization: Bearer {{auth}}

### Get Liked Notes
GET {{host}}/api/notes/liked
Authorization: Bearer {{auth}}

### Like Note
POST {{host}}/api/notes/1/like
Authorization: Bearer {{auth}}
POST http://localhost:8080/api/notes/2/like
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJsQGdtYWlsLmNvbSIsImlhdCI6MTc1NzcxOTkwNywiZXhwIjoxNzU3ODA2MzA3fQ.ZDVR7AgjPYTgJVA1oyMNRxo4uuIa2eSNmZjpoy3fyzg",

### Unlike Note
DELETE http://localhost:8080/api/notes/2/like
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ5QGdtYWlsLmNvbSIsImlhdCI6MTc1NzY4OTQzNSwiZXhwIjoxNzU3Nzc1ODM1fQ.HcU3jkSVyYRa-Fm5QrsUb82iZhJ7gsuZ8UKM21yQCI0

### Save Note
POST http://localhost:8080/api/notes/3/save
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJsQGdtYWlsLmNvbSIsImlhdCI6MTc1NzcxOTkwNywiZXhwIjoxNzU3ODA2MzA3fQ.ZDVR7AgjPYTgJVA1oyMNRxo4uuIa2eSNmZjpoy3fyzg",

### Unsave Note
DELETE http://localhost:8080/api/notes/2/save
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ5QGdtYWlsLmNvbSIsImlhdCI6MTc1NzY4OTQzNSwiZXhwIjoxNzU3Nzc1ODM1fQ.HcU3jkSVyYRa-Fm5QrsUb82iZhJ7gsuZ8UKM21yQCI0





